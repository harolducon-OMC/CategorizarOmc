# Docker Compose local. Cambia la contraseña antes de almacenar datos reales.
POSTGRES_USER=insights
POSTGRES_PASSWORD=change-this-local
POSTGRES_DB=insights
POSTGRES_PORT=5433

# Obligatorio: secreto aleatorio de >=32 caracteres; consérvalo: también cifra las API keys guardadas.
JWT_SECRET=REEMPLAZA_POR_64_CARACTERES_ALEATORIOS
# Dominio permitido sin @; por ejemplo omc.com para correo usuario@omc.com.
OMC_EMAIL_DOMAIN=omc.com
ACCESS_TOKEN_MINUTES=60

# --- Observabilidad y límites (opcionales) ---
# Sentry: deja vacío para desactivarlo. Crea un proyecto gratuito en sentry.io y pega el DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=INFO
# Peticiones que tardan más de estos segundos se registran como "lentas".
SLOW_REQUEST_SECONDS=5
# 1 desactiva los límites de peticiones (solo para pruebas locales).
RATE_LIMIT_DISABLED=
# 0 = no crear tablas al arrancar (úsalo cuando manejes el esquema solo con Alembic).
AUTO_CREATE_TABLES=1

# --- Rendimiento (opcional) ---
# Caché compartida entre instancias. Vacío = caché en memoria del propio proceso.
REDIS_URL=
# Pool de conexiones a PostgreSQL (valores por defecto entre paréntesis)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
# Trazas OpenTelemetry (necesita requirements-optional.txt). Vacío = desactivado.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=insights-api

# Oculta correos, teléfonos y documentos antes de enviar texto a un proveedor de IA (1 = activo, 0 = desactivado)
AI_REDACT_PII=1

# Correo de la ÚNICA persona que será super administrador (puede nombrar administradores). Se asigna al arrancar si ya existe, o al registrarse.
SUPERADMIN_EMAIL=

# --- Despliegue (opcional) ---
# Orígenes exactos del frontend permitidos por CORS, separados por coma (nunca «*»). Con el proxy de Vercel (/api) no hace falta.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cuántos proxies de confianza hay delante de la API: 0 en local, 1 detrás de Render solo, 2 si el tráfico pasa por Vercel y luego Render.
# Si es mayor que el real, un cliente puede falsificar su IP y esquivar los límites; si es menor, todos comparten el mismo límite.
TRUSTED_PROXY_HOPS=0
# 1 oculta /docs, /redoc y /openapi.json (recomendado en producción)
DISABLE_API_DOCS=
# Clave propia para cifrar las API keys guardadas (>=32 caracteres). Permite rotar JWT_SECRET sin perderlas.
API_KEY_ENCRYPTION_SECRET=
