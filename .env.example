# Docker Compose local. Cambia la contraseña antes de almacenar datos reales.
POSTGRES_USER=insights
POSTGRES_PASSWORD=change-this-local
POSTGRES_DB=insights
POSTGRES_PORT=5433

# Obligatorio: secreto aleatorio de >=32 caracteres; consérvalo: también cifra las API keys guardadas.
JWT_SECRET=REEMPLAZA_POR_64_CARACTERES_ALEATORIOS
# Dominio permitido sin @; por ejemplo omc.com para correo usuario@omc.com.
OMC_EMAIL_DOMAIN=omc.com
ACCESS_TOKEN_MINUTES=60

# --- Observabilidad y límites (opcionales) ---
# Sentry: deja vacío para desactivarlo. Crea un proyecto gratuito en sentry.io y pega el DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=INFO
# Peticiones que tardan más de estos segundos se registran como "lentas".
SLOW_REQUEST_SECONDS=5
# 1 desactiva los límites de peticiones (solo para pruebas locales).
RATE_LIMIT_DISABLED=
# 0 = no crear tablas al arrancar (úsalo cuando manejes el esquema solo con Alembic).
AUTO_CREATE_TABLES=1
